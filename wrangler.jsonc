{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "vars": {
    "DEFAULT_MODEL": "@cf/qwen/qwen3.8-27b",
    "FALLBACK_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-2-klein-9b"
  }
}
