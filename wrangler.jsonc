{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "vars": {
    "DEFAULT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "FALLBACK_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
