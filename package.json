{
  "name": "cf-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small AI chat UI on Cloudflare Workers with Workers AI and bring-your-own-key providers.",
  "scripts": {
    "dev": "vite build && concurrently -k -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "wrangler dev --var MOCK_AI:true --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "preview": "vite build && wrangler dev --var MOCK_AI:true --port 8787",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "idb-keyval": "^6.3.0",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^26.6.6",
    "concurrently": "^9.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
